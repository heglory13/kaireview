# =============================================================
# Production env template for Dokploy (no custom domain required)
# Replace the placeholder host with your actual Dokploy IP or host
# =============================================================

# Frontend public URLs
NEXT_PUBLIC_SITE_URL=http://<YOUR_DOKPLOY_HOST>:3000
NEXT_PUBLIC_API_BASE_URL=http://<YOUR_DOKPLOY_HOST>:4000

# Backend URLs
PUBLIC_SITE_URL=http://<YOUR_DOKPLOY_HOST>:3000
API_PUBLIC_URL=http://<YOUR_DOKPLOY_HOST>:4000

# Backend server
PORT=4000
HOSTNAME=0.0.0.0
SQLITE_PATH=/app/data/iaa.sqlite
CORS_ORIGIN=http://<YOUR_DOKPLOY_HOST>:3000
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

# Admin account
ADMIN_EMAIL=admin@your-site.com
ADMIN_PASSWORD=StrongPassword@123

# Optional SMTP for application notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=your-gmail@gmail.com
ADMIN_NOTIFICATION_EMAIL=admin@your-site.com
